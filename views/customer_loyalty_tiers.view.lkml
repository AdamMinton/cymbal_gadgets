view: customer_loyalty_tiers {
  derived_table: {
    explore_source: customer_spending {
      column: customerid {}
      column: customer_name {}
      column: customer_city {}
      column: customer_country {}
      column: loyaltytier {}
      column: spending_tier {}
      column: customer_lifetime_revenue {}
      column: customer_lifetime_gross_profit {}
      column: customer_lifetime_transactions {}
      column: customer_average_order_value {}
      column: spending_rank {}
      column: spending_percentile {}
      column: loyalty_tier_rank {}
      derived_column: spending_tier_rank {
        sql: ROW_NUMBER() OVER (PARTITION BY spending_tier ORDER BY customer_lifetime_revenue DESC) ;;
      }
    }
  }

  # --- Primary Key ---
  dimension: customerid {
    primary_key: yes
    hidden: yes
    description: "Unique identifier for the customer."
    type: number
    sql: ${TABLE}.customerid ;;
  }

  # --- Ranking & Tier Dimensions ---
  dimension: spending_tier {
    group_label: "Tier Rankings"
    label: "Spending Tier (Percentile Cohort)"
    description: "Customer spending tier cohort (Top 1%, Top 5%, Top 10%, Bottom 90%)."
    type: string
    sql: ${TABLE}.spending_tier ;;
  }

  dimension: loyaltytier {
    group_label: "Tier Rankings"
    label: "Current Loyalty Tier"
    description: "Assigned loyalty tier in the transactions table (Platinum, Gold, Silver, Bronze)."
    type: string
    sql: ${TABLE}.loyaltytier ;;
  }

  dimension: spending_tier_rank {
    group_label: "Tier Rankings"
    label: "Rank Within Spending Tier"
    description: "Rank of the customer by lifetime revenue within their Spending Tier (1 = highest spender in that percentile tier)."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.spending_tier_rank ;;
  }

  dimension: loyalty_tier_rank {
    group_label: "Tier Rankings"
    label: "Rank Within Current Loyalty Tier"
    description: "Rank of the customer by lifetime revenue within their Current Loyalty Tier (1 = highest spender in that loyalty tier)."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.loyalty_tier_rank ;;
  }

  dimension: is_top_10_in_spending_tier {
    group_label: "Tier Rankings"
    label: "Is Top 10 in Spending Tier?"
    description: "Yes if the customer is one of the Top 10 highest-spending members within their Spending Tier."
    type: yesno
    sql: ${spending_tier_rank} <= 10 ;;
  }

  dimension: is_top_10_in_loyalty_tier {
    group_label: "Tier Rankings"
    label: "Is Top 10 in Current Loyalty Tier?"
    description: "Yes if the customer is one of the Top 10 highest-spending members within their Current Loyalty Tier."
    type: yesno
    sql: ${loyalty_tier_rank} <= 10 ;;
  }

  # --- Customer Attributes & Metrics ---
  dimension: customer_name {
    group_label: "Customer Details"
    label: "Customer Name"
    description: "Full name of the customer."
    type: string
    sql: ${TABLE}.customer_name ;;
  }

  dimension: customer_city {
    group_label: "Customer Details"
    label: "Customer City"
    description: "City of the customer."
    type: string
    sql: ${TABLE}.customer_city ;;
  }

  dimension: customer_country {
    group_label: "Customer Details"
    label: "Customer Country"
    description: "Country of the customer."
    type: string
    map_layer_name: countries
    sql: ${TABLE}.customer_country ;;
  }

  dimension: customer_lifetime_revenue {
    group_label: "Customer Lifetime Metrics"
    label: "Customer Lifetime Revenue"
    description: "Total lifetime revenue spent by the customer."
    type: number
    value_format_name: usd
    sql: ${TABLE}.customer_lifetime_revenue ;;
  }

  dimension: customer_lifetime_gross_profit {
    group_label: "Customer Lifetime Metrics"
    label: "Customer Lifetime Gross Profit"
    description: "Total lifetime gross profit generated by the customer."
    type: number
    value_format_name: usd
    sql: ${TABLE}.customer_lifetime_gross_profit ;;
  }

  dimension: customer_lifetime_transactions {
    group_label: "Customer Lifetime Metrics"
    label: "Customer Lifetime Transactions"
    description: "Total lifetime transactions completed by the customer."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.customer_lifetime_transactions ;;
  }

  dimension: customer_average_order_value {
    group_label: "Customer Lifetime Metrics"
    label: "Customer Average Order Value"
    description: "Average order value for the customer."
    type: number
    value_format_name: usd
    sql: ${TABLE}.customer_average_order_value ;;
  }

  dimension: spending_rank {
    group_label: "Tier Rankings"
    label: "Overall Spending Rank"
    description: "Overall customer spending rank across all customers."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.spending_rank ;;
  }

  dimension: spending_percentile {
    group_label: "Tier Rankings"
    label: "Spending Percentile"
    description: "Customer spending percentile across all customers."
    type: number
    value_format_name: percent_2
    sql: ${TABLE}.spending_percentile ;;
  }

  # --- Measures ---
  measure: count_customers {
    label: "Total Customers"
    description: "Count of customers."
    type: count
    value_format_name: decimal_0
  }

  measure: total_revenue {
    label: "Total Revenue"
    description: "Total lifetime revenue across selected customers."
    type: sum
    sql: ${customer_lifetime_revenue} ;;
    value_format_name: usd_0
  }

  measure: average_lifetime_revenue {
    label: "Average Customer Revenue"
    description: "Average lifetime revenue per customer."
    type: average
    sql: ${customer_lifetime_revenue} ;;
    value_format_name: usd
  }
}

