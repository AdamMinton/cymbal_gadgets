view: customer_spending {
  derived_table: {
    explore_source: transactions {
      column: customerid {}
      column: customer_name {}
      column: customer_city {}
      column: customer_country {}
      column: loyaltytier {}
      column: total_revenue {}
      column: total_gross_profit {}
      column: count {}
      column: total_quantity_sold {}
      column: average_order_value {}
      derived_column: spending_rank {
        sql: ROW_NUMBER() OVER (ORDER BY total_revenue DESC) ;;
      }
      derived_column: spending_percentile {
        sql: PERCENT_RANK() OVER (ORDER BY total_revenue ASC) ;;
      }
      derived_column: loyalty_tier_rank {
        sql: ROW_NUMBER() OVER (PARTITION BY loyaltytier ORDER BY total_revenue DESC) ;;
      }
      derived_column: p99_threshold {
        sql: PERCENTILE_CONT(total_revenue, 0.99) OVER () ;;
      }
      derived_column: p95_threshold {
        sql: PERCENTILE_CONT(total_revenue, 0.95) OVER () ;;
      }
      derived_column: p90_threshold {
        sql: PERCENTILE_CONT(total_revenue, 0.90) OVER () ;;
      }
    }
  }

  # --- Primary Key ---
  dimension: customerid {
    primary_key: yes
    label: "Customer ID"
    description: "Unique identifier for the customer."
    type: number
    sql: ${TABLE}.customerid ;;
  }

  # --- Customer Attributes ---
  dimension: customer_name {
    group_label: "Customer Details"
    label: "Customer Name"
    description: "Full name of the customer."
    type: string
    sql: ${TABLE}.customer_name ;;
  }

  dimension: customer_city {
    group_label: "Customer Details"
    label: "Customer City"
    description: "City of the customer."
    type: string
    sql: ${TABLE}.customer_city ;;
  }

  dimension: customer_country {
    group_label: "Customer Details"
    label: "Customer Country"
    description: "Country of the customer."
    type: string
    map_layer_name: countries
    sql: ${TABLE}.customer_country ;;
  }

  dimension: loyaltytier {
    group_label: "Loyalty & Spending Tiers"
    label: "Current Loyalty Tier"
    description: "The customer's assigned loyalty tier in the transactions table (Platinum, Gold, Silver, Bronze)."
    type: string
    sql: ${TABLE}.loyaltytier ;;
  }

  # --- Customer Lifetime Metrics (Dimensions) ---
  dimension: customer_lifetime_revenue {
    group_label: "Customer Lifetime Metrics"
    label: "Customer Lifetime Revenue"
    description: "Total lifetime revenue spent by the customer across all transactions."
    type: number
    value_format_name: usd
    sql: ${TABLE}.total_revenue ;;
  }

  dimension: customer_lifetime_gross_profit {
    group_label: "Customer Lifetime Metrics"
    label: "Customer Lifetime Gross Profit"
    description: "Total lifetime gross profit generated by the customer."
    type: number
    value_format_name: usd
    sql: ${TABLE}.total_gross_profit ;;
  }

  dimension: customer_lifetime_transactions {
    group_label: "Customer Lifetime Metrics"
    label: "Customer Lifetime Transactions"
    description: "Total number of transactions completed by the customer."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.count ;;
  }

  dimension: customer_lifetime_quantity {
    group_label: "Customer Lifetime Metrics"
    label: "Customer Lifetime Quantity Purchased"
    description: "Total quantity of items purchased by the customer."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.total_quantity_sold ;;
  }

  dimension: customer_average_order_value {
    group_label: "Customer Lifetime Metrics"
    label: "Customer Average Order Value"
    description: "Average order value across all transactions for this customer."
    type: number
    value_format_name: usd
    sql: ${TABLE}.average_order_value ;;
  }

  # --- Threshold & Ranking Dimensions ---
  dimension: p99_threshold {
    hidden: yes
    type: number
    sql: ${TABLE}.p99_threshold ;;
  }

  dimension: p95_threshold {
    hidden: yes
    type: number
    sql: ${TABLE}.p95_threshold ;;
  }

  dimension: p90_threshold {
    hidden: yes
    type: number
    sql: ${TABLE}.p90_threshold ;;
  }

  dimension: spending_rank {
    group_label: "Loyalty & Spending Tiers"
    label: "Overall Spending Rank"
    description: "Rank of the customer by lifetime revenue across all customers (1 = highest spender)."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.spending_rank ;;
  }

  dimension: spending_percentile {
    group_label: "Loyalty & Spending Tiers"
    label: "Spending Percentile"
    description: "Customer's percentile rank based on lifetime revenue (0% to 100%)."
    type: number
    value_format_name: percent_2
    sql: ${TABLE}.spending_percentile ;;
  }

  dimension: loyalty_tier_rank {
    group_label: "Loyalty & Spending Tiers"
    label: "Rank Within Current Loyalty Tier"
    description: "Customer's spending rank within their currently assigned Loyalty Tier (1 = highest spender in tier)."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.loyalty_tier_rank ;;
  }

  dimension: is_top_1_percent {
    group_label: "Loyalty & Spending Tiers"
    label: "Is Top 1% Customer?"
    description: "Yes if the customer's lifetime revenue is at or above the 99th percentile (Top 1% threshold)."
    type: yesno
    sql: ${customer_lifetime_revenue} >= ${p99_threshold} ;;
  }

  dimension: is_top_5_percent {
    group_label: "Loyalty & Spending Tiers"
    label: "Is Top 5% Customer?"
    description: "Yes if the customer's lifetime revenue is at or above the 95th percentile (Top 5% threshold)."
    type: yesno
    sql: ${customer_lifetime_revenue} >= ${p95_threshold} ;;
  }

  dimension: is_top_10_percent {
    group_label: "Loyalty & Spending Tiers"
    label: "Is Top 10% Customer?"
    description: "Yes if the customer's lifetime revenue is at or above the 90th percentile (Top 10% threshold)."
    type: yesno
    sql: ${customer_lifetime_revenue} >= ${p90_threshold} ;;
  }

  dimension: spending_tier {
    group_label: "Loyalty & Spending Tiers"
    label: "Spending Tier (Percentile Cohort)"
    description: "Mutually exclusive customer spending tier based on lifetime revenue thresholds: Top 1%, Top 5% (1%-5%), Top 10% (5%-10%), and Bottom 90%."
    type: string
    sql:
      CASE
        WHEN ${customer_lifetime_revenue} >= ${p99_threshold} THEN '1. Top 1% (99th+ Percentile)'
        WHEN ${customer_lifetime_revenue} >= ${p95_threshold} THEN '2. Top 5% (95th-99th Percentile)'
        WHEN ${customer_lifetime_revenue} >= ${p90_threshold} THEN '3. Top 10% (90th-95th Percentile)'
        ELSE '4. Bottom 90% (<90th Percentile)'
      END ;;
  }

  # --- Measures: Revenue Thresholds (Percentiles) ---
  measure: top_1_pct_revenue_threshold {
    group_label: "Spending Thresholds"
    label: "Top 1% Revenue Threshold (99th Percentile)"
    description: "Minimum lifetime revenue required for a customer to reach the Top 1% (99th percentile)."
    type: percentile
    percentile: 99
    sql: ${customer_lifetime_revenue} ;;
    value_format_name: usd
  }

  measure: top_5_pct_revenue_threshold {
    group_label: "Spending Thresholds"
    label: "Top 5% Revenue Threshold (95th Percentile)"
    description: "Minimum lifetime revenue required for a customer to reach the Top 5% (95th percentile)."
    type: percentile
    percentile: 95
    sql: ${customer_lifetime_revenue} ;;
    value_format_name: usd
  }

  measure: top_10_pct_revenue_threshold {
    group_label: "Spending Thresholds"
    label: "Top 10% Revenue Threshold (90th Percentile)"
    description: "Minimum lifetime revenue required for a customer to reach the Top 10% (90th percentile)."
    type: percentile
    percentile: 90
    sql: ${customer_lifetime_revenue} ;;
    value_format_name: usd
  }

  measure: median_customer_lifetime_revenue {
    group_label: "Spending Thresholds"
    label: "Median Customer Lifetime Revenue (50th Percentile)"
    description: "Median (50th percentile) lifetime revenue across customers."
    type: median
    sql: ${customer_lifetime_revenue} ;;
    value_format_name: usd
  }

  # --- Measures: Customer & Revenue Aggregations ---
  measure: count_customers {
    label: "Total Customers"
    description: "Total count of unique customers in the spending analysis."
    type: count
    value_format_name: decimal_0
    drill_fields: [customer_spending_details*]
  }

  measure: total_customer_revenue {
    label: "Total Customer Revenue"
    description: "Sum of lifetime revenue across customers."
    type: sum
    sql: ${customer_lifetime_revenue} ;;
    value_format_name: usd_0
    drill_fields: [customer_spending_details*]
  }

  measure: average_customer_lifetime_revenue {
    label: "Average Customer Lifetime Revenue"
    description: "Average lifetime revenue per customer."
    type: average
    sql: ${customer_lifetime_revenue} ;;
    value_format_name: usd
    drill_fields: [customer_spending_details*]
  }

  measure: max_customer_lifetime_revenue {
    label: "Max Customer Lifetime Revenue"
    description: "Highest lifetime revenue of a single customer."
    type: max
    sql: ${customer_lifetime_revenue} ;;
    value_format_name: usd
  }

  measure: min_customer_lifetime_revenue {
    label: "Min Customer Lifetime Revenue"
    description: "Lowest lifetime revenue of a single customer."
    type: min
    sql: ${customer_lifetime_revenue} ;;
    value_format_name: usd
  }

  # --- Measures: Cumulative Top X% Cohort Metrics ---
  measure: top_1_pct_customer_count {
    group_label: "Top Percentile Cohort Metrics"
    label: "Top 1% Customer Count"
    description: "Number of customers in the Top 1% of lifetime spending."
    type: count
    filters: [is_top_1_percent: "Yes"]
    value_format_name: decimal_0
    drill_fields: [customer_spending_details*]
  }

  measure: top_5_pct_customer_count {
    group_label: "Top Percentile Cohort Metrics"
    label: "Top 5% Customer Count"
    description: "Number of customers in the Top 5% (cumulative) of lifetime spending."
    type: count
    filters: [is_top_5_percent: "Yes"]
    value_format_name: decimal_0
    drill_fields: [customer_spending_details*]
  }

  measure: top_10_pct_customer_count {
    group_label: "Top Percentile Cohort Metrics"
    label: "Top 10% Customer Count"
    description: "Number of customers in the Top 10% (cumulative) of lifetime spending."
    type: count
    filters: [is_top_10_percent: "Yes"]
    value_format_name: decimal_0
    drill_fields: [customer_spending_details*]
  }

  measure: top_1_pct_total_revenue {
    group_label: "Top Percentile Cohort Metrics"
    label: "Top 1% Total Revenue"
    description: "Total lifetime revenue generated by customers in the Top 1%."
    type: sum
    sql: ${customer_lifetime_revenue} ;;
    filters: [is_top_1_percent: "Yes"]
    value_format_name: usd_0
    drill_fields: [customer_spending_details*]
  }

  measure: top_5_pct_total_revenue {
    group_label: "Top Percentile Cohort Metrics"
    label: "Top 5% Total Revenue (Cumulative)"
    description: "Total lifetime revenue generated by customers in the Top 5% (cumulative)."
    type: sum
    sql: ${customer_lifetime_revenue} ;;
    filters: [is_top_5_percent: "Yes"]
    value_format_name: usd_0
    drill_fields: [customer_spending_details*]
  }

  measure: top_10_pct_total_revenue {
    group_label: "Top Percentile Cohort Metrics"
    label: "Top 10% Total Revenue (Cumulative)"
    description: "Total lifetime revenue generated by customers in the Top 10% (cumulative)."
    type: sum
    sql: ${customer_lifetime_revenue} ;;
    filters: [is_top_10_percent: "Yes"]
    value_format_name: usd_0
    drill_fields: [customer_spending_details*]
  }

  measure: top_1_pct_revenue_share {
    group_label: "Top Percentile Cohort Metrics"
    label: "Top 1% Share of Total Revenue"
    description: "Percentage of total company revenue generated by the Top 1% of customers."
    type: number
    sql: 1.0 * ${top_1_pct_total_revenue} / NULLIF(${total_customer_revenue}, 0) ;;
    value_format_name: percent_2
  }

  measure: top_5_pct_revenue_share {
    group_label: "Top Percentile Cohort Metrics"
    label: "Top 5% Share of Total Revenue (Cumulative)"
    description: "Percentage of total company revenue generated by the Top 5% of customers (cumulative)."
    type: number
    sql: 1.0 * ${top_5_pct_total_revenue} / NULLIF(${total_customer_revenue}, 0) ;;
    value_format_name: percent_2
  }

  measure: top_10_pct_revenue_share {
    group_label: "Top Percentile Cohort Metrics"
    label: "Top 10% Share of Total Revenue (Cumulative)"
    description: "Percentage of total company revenue generated by the Top 10% of customers (cumulative)."
    type: number
    sql: 1.0 * ${top_10_pct_total_revenue} / NULLIF(${total_customer_revenue}, 0) ;;
    value_format_name: percent_2
  }

  measure: total_customer_gross_profit {
    label: "Total Customer Gross Profit"
    description: "Sum of lifetime gross profit across customers."
    type: sum
    sql: ${customer_lifetime_gross_profit} ;;
    value_format_name: usd_0
    drill_fields: [customer_spending_details*]
  }

  measure: total_customer_transactions {
    label: "Total Customer Transactions"
    description: "Sum of lifetime transactions across customers."
    type: sum
    sql: ${customer_lifetime_transactions} ;;
    value_format_name: decimal_0
    drill_fields: [customer_spending_details*]
  }

  measure: average_customer_transactions {
    label: "Average Transactions per Customer"
    description: "Average number of lifetime transactions per customer."
    type: average
    sql: ${customer_lifetime_transactions} ;;
    value_format_name: decimal_1
  }

  set: customer_spending_details {
    fields: [
      customerid,
      customer_name,
      loyaltytier,
      spending_tier,
      spending_rank,
      customer_lifetime_transactions,
      customer_lifetime_revenue,
      customer_lifetime_gross_profit
    ]
  }
}
