view: customer_loyalty_tiers_ndt {
  derived_table: {
    explore_source: customer_spending_ndt {
      column: customerid { field: customer_spending_ndt.customerid }
      column: customer_name { field: customer_spending_ndt.customer_name }
      column: customer_city { field: customer_spending_ndt.customer_city }
      column: customer_country { field: customer_spending_ndt.customer_country }
      column: loyaltytier { field: customer_spending_ndt.loyaltytier }
      column: spend_percentile_tier { field: customer_spending_ndt.spend_percentile_tier }
      column: overall_spend_rank { field: customer_spending_ndt.overall_spend_rank }
      column: existing_tier_spend_rank { field: customer_spending_ndt.existing_tier_spend_rank }
      column: lifetime_revenue { field: customer_spending_ndt.total_lifetime_revenue }
      column: lifetime_gross_profit { field: customer_spending_ndt.total_lifetime_gross_profit }
      column: lifetime_transactions { field: customer_spending_ndt.lifetime_transactions }
      column: average_order_value { field: customer_spending_ndt.average_order_value }
      derived_column: spend_percentile_tier_rank {
        sql: ROW_NUMBER() OVER (PARTITION BY spend_percentile_tier ORDER BY lifetime_revenue DESC) ;;
      }
    }
  }

  # --- Primary Key ---
  dimension: customerid {
    primary_key: yes
    label: "Customer ID"
    description: "Unique identifier for the customer."
    type: number
    sql: ${TABLE}.customerid ;;
  }

  # --- Dimensions ---
  dimension: customer_name {
    label: "Customer Name"
    description: "Full name of the customer."
    type: string
    sql: ${TABLE}.customer_name ;;
  }

  dimension: customer_city {
    label: "Customer City"
    description: "City of the customer."
    type: string
    sql: ${TABLE}.customer_city ;;
  }

  dimension: customer_country {
    label: "Customer Country"
    description: "Country of the customer."
    type: string
    map_layer_name: countries
    sql: ${TABLE}.customer_country ;;
  }

  dimension: loyaltytier {
    label: "Assigned Loyalty Tier"
    description: "Existing loyalty tier assigned in the transactions table."
    type: string
    sql: ${TABLE}.loyaltytier ;;
  }

  dimension: spend_percentile_tier {
    label: "Spend Percentile Tier"
    description: "Spend-based loyalty tier (Top 1% Platinum, Top 5% Gold, Top 10% Silver, Bottom 90% Bronze)."
    type: string
    sql: ${TABLE}.spend_percentile_tier ;;
  }

  dimension: overall_spend_rank {
    label: "Overall Spend Rank"
    description: "Overall customer rank by total lifetime revenue."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.overall_spend_rank ;;
  }

  dimension: existing_tier_spend_rank {
    label: "Rank in Assigned Tier"
    description: "Customer's rank within their assigned loyalty tier."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.existing_tier_spend_rank ;;
  }

  dimension: spend_percentile_tier_rank {
    label: "Rank in Spend Percentile Tier"
    description: "Customer's rank (1 = highest) within their Spend Percentile Tier."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.spend_percentile_tier_rank ;;
  }

  dimension: is_top_10_in_spend_tier {
    label: "Is Top 10 in Spend Tier?"
    description: "Yes if the customer is among the Top 10 highest-spending members of their Spend Percentile Tier."
    type: yesno
    sql: ${spend_percentile_tier_rank} <= 10 ;;
  }

  dimension: is_top_10_in_assigned_tier {
    label: "Is Top 10 in Assigned Tier?"
    description: "Yes if the customer is among the Top 10 highest-spending members of their Assigned Loyalty Tier."
    type: yesno
    sql: ${existing_tier_spend_rank} <= 10 ;;
  }

  dimension: lifetime_revenue {
    label: "Lifetime Revenue"
    description: "Total lifetime revenue generated by the customer."
    type: number
    value_format_name: usd
    sql: ${TABLE}.lifetime_revenue ;;
  }

  dimension: lifetime_gross_profit {
    label: "Lifetime Gross Profit"
    description: "Total lifetime gross profit generated by the customer."
    type: number
    value_format_name: usd
    sql: ${TABLE}.lifetime_gross_profit ;;
  }

  dimension: lifetime_transactions {
    label: "Lifetime Transactions"
    description: "Total lifetime transactions by the customer."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.lifetime_transactions ;;
  }

  dimension: average_order_value {
    label: "Customer AOV"
    description: "Average order value for the customer."
    type: number
    value_format_name: usd
    sql: ${TABLE}.average_order_value ;;
  }

  # --- Measures ---
  measure: count {
    label: "Customer Count"
    description: "Count of customers."
    type: count
    value_format_name: decimal_0
  }

  measure: total_revenue {
    label: "Total Revenue"
    description: "Sum of customer lifetime revenue."
    type: sum
    sql: ${lifetime_revenue} ;;
    value_format_name: usd_0
  }

  measure: total_gross_profit {
    label: "Total Gross Profit"
    description: "Sum of customer lifetime gross profit."
    type: sum
    sql: ${lifetime_gross_profit} ;;
    value_format_name: usd_0
  }

  measure: average_customer_revenue {
    label: "Average Revenue per Customer"
    description: "Average lifetime revenue per customer."
    type: average
    sql: ${lifetime_revenue} ;;
    value_format_name: usd
  }
}

