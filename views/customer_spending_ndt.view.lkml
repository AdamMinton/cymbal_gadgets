view: customer_spending_ndt {
  derived_table: {
    explore_source: transactions {
      column: customerid { field: transactions.customerid }
      column: customer_name { field: transactions.customer_name }
      column: customer_city { field: transactions.customer_city }
      column: customer_country { field: transactions.customer_country }
      column: loyaltytier { field: transactions.loyaltytier }
      column: lifetime_revenue { field: transactions.total_revenue }
      column: lifetime_gross_profit { field: transactions.total_gross_profit }
      column: lifetime_transactions { field: transactions.count }
      column: lifetime_quantity_sold { field: transactions.total_quantity_sold }
      column: average_order_value { field: transactions.average_order_value }
      derived_column: overall_spend_rank {
        sql: RANK() OVER (ORDER BY lifetime_revenue DESC) ;;
      }
      derived_column: spend_cume_dist {
        sql: CUME_DIST() OVER (ORDER BY lifetime_revenue DESC) ;;
      }
      derived_column: existing_tier_spend_rank {
        sql: ROW_NUMBER() OVER (PARTITION BY loyaltytier ORDER BY lifetime_revenue DESC) ;;
      }
      derived_column: p99_revenue_threshold {
        sql: PERCENTILE_CONT(lifetime_revenue, 0.99) OVER () ;;
      }
      derived_column: p95_revenue_threshold {
        sql: PERCENTILE_CONT(lifetime_revenue, 0.95) OVER () ;;
      }
      derived_column: p90_revenue_threshold {
        sql: PERCENTILE_CONT(lifetime_revenue, 0.90) OVER () ;;
      }
    }
  }

  # --- Primary Key ---
  dimension: customerid {
    primary_key: yes
    label: "Customer ID"
    description: "Unique identifier for each customer."
    type: number
    sql: ${TABLE}.customerid ;;
  }

  # --- Customer Attributes & Ranks ---
  dimension: customer_name {
    label: "Customer Name"
    description: "Full name of the customer."
    type: string
    sql: ${TABLE}.customer_name ;;
  }

  dimension: customer_city {
    label: "Customer City"
    description: "City of the customer."
    type: string
    sql: ${TABLE}.customer_city ;;
  }

  dimension: customer_country {
    label: "Customer Country"
    description: "Country of the customer."
    type: string
    map_layer_name: countries
    sql: ${TABLE}.customer_country ;;
  }

  dimension: loyaltytier {
    label: "Assigned Loyalty Tier"
    description: "The customer's existing assigned loyalty tier in the transactions table."
    type: string
    sql: ${TABLE}.loyaltytier ;;
  }

  dimension: lifetime_revenue {
    label: "Customer Lifetime Revenue"
    description: "Total lifetime revenue spent by the customer across all transactions."
    type: number
    value_format_name: usd
    sql: ${TABLE}.lifetime_revenue ;;
  }

  dimension: lifetime_gross_profit {
    label: "Customer Lifetime Gross Profit"
    description: "Total lifetime gross profit generated by the customer."
    type: number
    value_format_name: usd
    sql: ${TABLE}.lifetime_gross_profit ;;
  }

  dimension: lifetime_transactions {
    label: "Customer Lifetime Transactions"
    description: "Total number of transactions completed by the customer."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.lifetime_transactions ;;
  }

  dimension: lifetime_quantity_sold {
    label: "Customer Lifetime Quantity"
    description: "Total quantity of items purchased by the customer."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.lifetime_quantity_sold ;;
  }

  dimension: average_order_value {
    label: "Customer Average Order Value"
    description: "Average revenue per transaction for this customer."
    type: number
    value_format_name: usd
    sql: ${TABLE}.average_order_value ;;
  }

  dimension: overall_spend_rank {
    label: "Overall Spend Rank"
    description: "Rank of the customer by total lifetime revenue (1 = highest spender)."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.overall_spend_rank ;;
  }

  dimension: spend_cume_dist {
    label: "Spend Cumulative Distribution"
    description: "Cumulative distribution of customer spend from top (0.01 = top 1%)."
    type: number
    value_format_name: percent_2
    sql: ${TABLE}.spend_cume_dist ;;
  }

  dimension: existing_tier_spend_rank {
    label: "Rank Within Assigned Tier"
    description: "Customer's spending rank within their currently assigned loyalty tier."
    type: number
    value_format_name: decimal_0
    sql: ${TABLE}.existing_tier_spend_rank ;;
  }

  dimension: p99_revenue_threshold {
    hidden: yes
    type: number
    value_format_name: usd
    sql: ${TABLE}.p99_revenue_threshold ;;
  }

  dimension: p95_revenue_threshold {
    hidden: yes
    type: number
    value_format_name: usd
    sql: ${TABLE}.p95_revenue_threshold ;;
  }

  dimension: p90_revenue_threshold {
    hidden: yes
    type: number
    value_format_name: usd
    sql: ${TABLE}.p90_revenue_threshold ;;
  }

  dimension: spend_percentile_tier {
    label: "Spend Percentile Tier"
    description: "Customer loyalty tier based on spending thresholds: Top 1% (Platinum Elite), Top 5% (Gold), Top 10% (Silver), and Standard (Remaining 90%)."
    type: string
    sql: CASE
      WHEN ${lifetime_revenue} >= ${p99_revenue_threshold} THEN '1. Top 1% (Platinum)'
      WHEN ${lifetime_revenue} >= ${p95_revenue_threshold} THEN '2. Top 5% (Gold)'
      WHEN ${lifetime_revenue} >= ${p90_revenue_threshold} THEN '3. Top 10% (Silver)'
      ELSE '4. Bottom 90% (Bronze)'
    END ;;
  }

  dimension: is_top_1_pct {
    label: "Is Top 1% Customer?"
    description: "Yes if the customer's lifetime revenue is at or above the 99th percentile threshold."
    type: yesno
    sql: ${lifetime_revenue} >= ${p99_revenue_threshold} ;;
  }

  dimension: is_top_5_pct {
    label: "Is Top 5% Customer?"
    description: "Yes if the customer's lifetime revenue is at or above the 95th percentile threshold."
    type: yesno
    sql: ${lifetime_revenue} >= ${p95_revenue_threshold} ;;
  }

  dimension: is_top_10_pct {
    label: "Is Top 10% Customer?"
    description: "Yes if the customer's lifetime revenue is at or above the 90th percentile threshold."
    type: yesno
    sql: ${lifetime_revenue} >= ${p90_revenue_threshold} ;;
  }

  # --- Measures ---
  measure: count {
    label: "Total Customers"
    description: "Total count of unique customers in the NDT."
    type: count
    value_format_name: decimal_0
    drill_fields: [customer_loyalty_details*]
  }

  measure: total_lifetime_revenue {
    label: "Total Customer Revenue"
    description: "Sum of lifetime revenue across customers."
    type: sum
    sql: ${lifetime_revenue} ;;
    value_format_name: usd_0
    drill_fields: [customer_loyalty_details*]
  }

  measure: total_lifetime_gross_profit {
    label: "Total Customer Gross Profit"
    description: "Sum of lifetime gross profit across customers."
    type: sum
    sql: ${lifetime_gross_profit} ;;
    value_format_name: usd_0
    drill_fields: [customer_loyalty_details*]
  }

  measure: average_lifetime_revenue {
    label: "Average Revenue per Customer"
    description: "Average lifetime revenue per customer."
    type: average
    sql: ${lifetime_revenue} ;;
    value_format_name: usd
    drill_fields: [customer_loyalty_details*]
  }

  measure: median_lifetime_revenue {
    label: "Median Revenue per Customer (50th Percentile)"
    description: "Median (50th percentile) lifetime revenue across customers."
    type: median
    sql: ${lifetime_revenue} ;;
    value_format_name: usd
    drill_fields: [customer_loyalty_details*]
  }

  measure: revenue_threshold_top_1_pct {
    label: "Top 1% Revenue Threshold"
    description: "99th percentile of customer lifetime revenue (revenue threshold for the top 1% of customers)."
    type: percentile
    percentile: 99
    sql: ${lifetime_revenue} ;;
    value_format_name: usd
    drill_fields: [customer_loyalty_details*]
  }

  measure: revenue_threshold_top_5_pct {
    label: "Top 5% Revenue Threshold"
    description: "95th percentile of customer lifetime revenue (revenue threshold for the top 5% of customers)."
    type: percentile
    percentile: 95
    sql: ${lifetime_revenue} ;;
    value_format_name: usd
    drill_fields: [customer_loyalty_details*]
  }

  measure: revenue_threshold_top_10_pct {
    label: "Top 10% Revenue Threshold"
    description: "90th percentile of customer lifetime revenue (revenue threshold for the top 10% of customers)."
    type: percentile
    percentile: 90
    sql: ${lifetime_revenue} ;;
    value_format_name: usd
    drill_fields: [customer_loyalty_details*]
  }

  measure: exact_p99_revenue_threshold {
    label: "Top 1% Revenue Threshold (Exact PERCENTILE_CONT)"
    description: "Exact 99th percentile customer lifetime revenue calculated via BigQuery PERCENTILE_CONT window function."
    type: max
    sql: ${p99_revenue_threshold} ;;
    value_format_name: usd
    drill_fields: [customer_loyalty_details*]
  }

  measure: exact_p95_revenue_threshold {
    label: "Top 5% Revenue Threshold (Exact PERCENTILE_CONT)"
    description: "Exact 95th percentile customer lifetime revenue calculated via BigQuery PERCENTILE_CONT window function."
    type: max
    sql: ${p95_revenue_threshold} ;;
    value_format_name: usd
    drill_fields: [customer_loyalty_details*]
  }

  measure: exact_p90_revenue_threshold {
    label: "Top 10% Revenue Threshold (Exact PERCENTILE_CONT)"
    description: "Exact 90th percentile customer lifetime revenue calculated via BigQuery PERCENTILE_CONT window function."
    type: max
    sql: ${p90_revenue_threshold} ;;
    value_format_name: usd
    drill_fields: [customer_loyalty_details*]
  }

  measure: min_lifetime_revenue {
    label: "Minimum Customer Revenue"
    description: "Minimum lifetime revenue among customers in the group."
    type: min
    sql: ${lifetime_revenue} ;;
    value_format_name: usd
  }

  measure: max_lifetime_revenue {
    label: "Maximum Customer Revenue"
    description: "Maximum lifetime revenue among customers in the group."
    type: max
    sql: ${lifetime_revenue} ;;
    value_format_name: usd
  }

  measure: top_1_pct_customer_count {
    label: "Top 1% Customer Count"
    description: "Number of customers in the top 1% of lifetime spend."
    type: count
    filters: [is_top_1_pct: "Yes"]
    value_format_name: decimal_0
    drill_fields: [customer_loyalty_details*]
  }

  measure: top_5_pct_customer_count {
    label: "Top 5% Customer Count"
    description: "Number of customers in the top 5% of lifetime spend."
    type: count
    filters: [is_top_5_pct: "Yes"]
    value_format_name: decimal_0
    drill_fields: [customer_loyalty_details*]
  }

  measure: top_10_pct_customer_count {
    label: "Top 10% Customer Count"
    description: "Number of customers in the top 10% of lifetime spend."
    type: count
    filters: [is_top_10_pct: "Yes"]
    value_format_name: decimal_0
    drill_fields: [customer_loyalty_details*]
  }

  measure: top_1_pct_revenue {
    label: "Top 1% Customer Revenue"
    description: "Total revenue generated by customers in the top 1% of lifetime spend."
    type: sum
    sql: ${lifetime_revenue} ;;
    filters: [is_top_1_pct: "Yes"]
    value_format_name: usd_0
    drill_fields: [customer_loyalty_details*]
  }

  measure: top_5_pct_revenue {
    label: "Top 5% Customer Revenue"
    description: "Total revenue generated by customers in the top 5% of lifetime spend."
    type: sum
    sql: ${lifetime_revenue} ;;
    filters: [is_top_5_pct: "Yes"]
    value_format_name: usd_0
    drill_fields: [customer_loyalty_details*]
  }

  measure: top_10_pct_revenue {
    label: "Top 10% Customer Revenue"
    description: "Total revenue generated by customers in the top 10% of lifetime spend."
    type: sum
    sql: ${lifetime_revenue} ;;
    filters: [is_top_10_pct: "Yes"]
    value_format_name: usd_0
    drill_fields: [customer_loyalty_details*]
  }

  measure: top_1_pct_revenue_share {
    label: "Top 1% Revenue Share (%)"
    description: "Percentage of total revenue generated by the top 1% of customers."
    type: number
    sql: 1.0 * ${top_1_pct_revenue} / NULLIF(${total_lifetime_revenue}, 0) ;;
    value_format_name: percent_2
  }

  measure: top_5_pct_revenue_share {
    label: "Top 5% Revenue Share (%)"
    description: "Percentage of total revenue generated by the top 5% of customers."
    type: number
    sql: 1.0 * ${top_5_pct_revenue} / NULLIF(${total_lifetime_revenue}, 0) ;;
    value_format_name: percent_2
  }

  measure: top_10_pct_revenue_share {
    label: "Top 10% Revenue Share (%)"
    description: "Percentage of total revenue generated by the top 10% of customers."
    type: number
    sql: 1.0 * ${top_10_pct_revenue} / NULLIF(${total_lifetime_revenue}, 0) ;;
    value_format_name: percent_2
  }

  # --- Drill Set ---
  set: customer_loyalty_details {
    fields: [
      overall_spend_rank,
      customerid,
      customer_name,
      customer_country,
      loyaltytier,
      spend_percentile_tier,
      lifetime_transactions,
      lifetime_revenue,
      lifetime_gross_profit
    ]
  }
}
